{
  "name": "dockerun-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test:images": "node --test tests/localImages.test.mjs",
    "test:containers": "node --test tests/containers.test.mjs tests/containerLogs.test.mjs",
    "test:networks": "node --test tests/networks.test.mjs",
    "test:volumes": "node --test tests/volumes.test.mjs",
    "test:registries": "node --test tests/registries.test.mjs",
    "test:builtin": "node --test tests/builtin.test.mjs",
    "test:maintenance": "node --test tests/maintenance.test.mjs",
    "test:users": "node --test tests/users.test.mjs",
    "test:management": "node --test tests/management.test.mjs tests/workspaceDeletion.test.mjs",
    "test:navigation": "node --test tests/navigation.test.mjs",
    "test:unsaved-changes": "node --test tests/unsavedChanges.test.mjs",
    "test:releases": "node --test tests/releases.test.mjs tests/applicationDetail.test.mjs tests/deploymentParameters.test.mjs tests/releaseConfigFiles.test.mjs tests/codeLanguage.test.mjs tests/composeServices.test.mjs tests/deploymentPreview.test.mjs tests/composeProject.test.mjs",
    "test:deployments": "node --test tests/deployments.test.mjs",
    "test:templates": "node --test tests/applicationTemplates.test.mjs tests/templatePackages.test.mjs",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@vueuse/core": "^14.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.6.0",
    "crypto-js": "^4.2.0",
    "element-plus": "^2.5.0",
    "monaco-editor": "^0.55.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "~5.6.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.1.0"
  }
}
