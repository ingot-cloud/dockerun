# Dockerun 构建与交付配置。可复制为 build.env，再按需修改。
# build.env 与 build.*.env 不提交 Git，也不会进入镜像构建上下文。
# 值按单行字面量读取，可用引号包住；不执行变量插值或命令替换。
# 已导出的同名环境变量优先；BUILD_ENV_FILE 可指定其他配置文件。

# 仓库主机名和可选端口，不含 https:// 或路径；留空使用 Docker 默认仓库。
REGISTRY=
# 镜像名称可包含命名空间，例如 ingot/dockerun，不包含标签。
IMAGE_NAME=dockerun
# 留空时读取根目录 VERSION，当前为 2.0.0。
IMAGE_TAG=
# 完整镜像引用，可覆盖以上三项，例如 registry.example.com/team/dockerun:2.0.0。
# IMAGE=
# 可选附加标签，用逗号分隔，例如 latest,stable；不会默认覆盖 latest。
EXTRA_TAGS=

PLATFORMS=linux/amd64,linux/arm64
# 导出离线包和推送可独立开启；默认仅导出，推送前自行 docker login。
EXPORT=1
PUSH=0
# 默认 docker-packages/镜像短名称-标签，自动追加 -amd64.tar、-arm64.tar。
# 相对路径以仓库根目录为基准。
OUTPUT_PREFIX=

# 可选 Buildx builder；留空使用当前 builder，不自动创建或切换。
BUILDER=
# 构建目录相对于仓库根目录，Dockerfile 相对于构建目录。
BUILD_CONTEXT=.
DOCKERFILE=Dockerfile
# 默认复用缓存；PULL=1 刷新基础镜像，NO_CACHE=1 禁用构建缓存。
NO_CACHE=0
PULL=0
PROGRESS=auto
# 设为 1 或使用 ./build.sh --dry-run，仅预览命令。
DRY_RUN=0
