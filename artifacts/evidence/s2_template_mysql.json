      "name": "mysql-from-template-2222",
      "description": "从模板 mysql 创建",
      "kind": "compose",
      "scripts": {
        "before": "",
        "deploy": "",
        "after": ""
      },
      "category": "middleware",
      "template_id": "mysql",
      "template_version": "1.0.0",
      "definition": {
        "execution": {
          "mode": "",
          "command": "",
          "work_dir": "",
          "check_command": "",
          "timeout_seconds": 0
        },
        "compose": "services:\n  mysql:\n    image: ${MYSQL_IMAGE:?请填写 MySQL 镜像}\n    restart: unless-stopped\n    ports: ['${MYSQL_PORT}:3306']\n    environment:\n      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD:?请填写管理员密码}\n    volumes: ['mysql-data:/var/lib/mysql']\n    healthcheck:\n      test: [CMD-SHELL, 'MYSQL_PWD=\"$$MYSQL_ROOT_PASSWORD\" mysqladmin ping -h 127.0.0.1 --silent']\n      interval: 5s\n      timeout: 5s\n      retries: 30\n      start_period: 30s\nvolumes:\n  mysql-data: {}\n",
        "configs": null,
        "parameters": [
          {
            "key": "MYSQL_IMAGE",
            "label": "MySQL 镜像",
            "type": "image",
            "default": "mysql:8.0.44",
            "required": true,
            "help": "默认使用所选仓库的同名镜像，请先准备该镜像。"
          },
          {
            "key": "MYSQL_PORT",
            "label": "数据库端口",
            "type": "port",
            "default": "3306",
            "required": true,
            "help": "填写目标主机未占用的端口。"
          },
          {
            "key": "MYSQL_ROOT_PASSWORD",
            "label": "管理员密码",
            "type": "password",
            "default": "",
            "required": true,
            "help": "仅保存到当前环境，不写入公共模板。"
          }
        ],
        "stateful": true,
        "topology": "single_host",
        "instructions": "默认手动发布。升级前备份数据库并确认数据格式兼容；切回旧镜像不会恢复业务数据。",
        "storage": "mysql-data → /var/lib/mysql；数据卷与应用环境绑定，重新部署和升级会复用原数据。",
        "initialization": "MySQL 仅在数据卷为空时初始化。更改环境中的初始密码不会修改已有数据库密码。",
        "endpoints": [
          {
            "name": "数据库连接",
            "port": "MYSQL_PORT",
            "protocol": "mysql",
            "path": ""
          }
        ]
      }
