{
  "schema_version": 1,
  "id": "nacos-standalone",
  "name": "Nacos 单机",
  "version": "1.0.1",
  "description": "内嵌存储的单节点 Nacos，配置与日志独立持久化。",
  "category": "middleware",
  "order": 40,
  "definition": {
    "compose_file": "compose.yaml",
    "parameters": [
      {
        "key": "NACOS_IMAGE",
        "label": "Nacos 镜像",
        "type": "image",
        "default": "nacos/nacos-server:v3.1.1",
        "required": true,
        "help": "默认使用所选仓库的同名镜像，请先准备该镜像。"
      },
      {
        "key": "NACOS_PORT",
        "label": "服务端口",
        "type": "port",
        "default": "8848",
        "required": true,
        "help": "填写目标主机未占用的端口。"
      },
      {
        "key": "NACOS_CONSOLE_PORT",
        "label": "控制台端口",
        "type": "port",
        "default": "8181",
        "required": true,
        "help": "填写目标主机未占用的端口。"
      },
      {
        "key": "NACOS_AUTH_TOKEN",
        "label": "认证令牌（Base64）",
        "type": "password",
        "default": "",
        "required": true,
        "help": "填写 Base64 编码、解码后至少 32 字节的随机密钥，各节点使用同一值。"
      },
      {
        "key": "NACOS_IDENTITY_KEY",
        "label": "节点身份名称",
        "type": "string",
        "default": "dockerun",
        "required": true,
        "help": "同一集群的节点必须一致。"
      },
      {
        "key": "NACOS_IDENTITY_VALUE",
        "label": "节点身份密钥",
        "type": "password",
        "default": "",
        "required": true,
        "help": "仅保存到当前环境，不写入公共模板。"
      }
    ],
    "stateful": true,
    "topology": "single_host",
    "instructions": "默认手动发布。服务端口需与对应 gRPC 客户端端口一起开放。首次访问控制台时，按 Nacos 引导设置管理员密码。",
    "storage": "每个节点分别使用独立的数据卷和日志卷。",
    "initialization": "",
    "endpoints": [
      {
        "name": "控制台",
        "port": "NACOS_CONSOLE_PORT",
        "protocol": "http",
        "path": ""
      },
      {
        "name": "服务地址",
        "port": "NACOS_PORT",
        "protocol": "http",
        "path": "/nacos"
      }
    ]
  }
}
