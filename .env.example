# The public URL is used by Docker's authentication challenge; it must be reachable by clients and Docker daemons.
PUBLIC_URL=https://dockerun.example.com
DOCKERUN_IMAGE=dockerun:2.0.0
# 默认命名卷，容器内部目录固定为 /var/lib/dockerun。
DATA_VOLUME=dockerun-data
# 目录绑定请同时使用 docker-compose.bind.yml，DATA_DIR 仅表示宿主机目录。
# COMPOSE_FILE=docker-compose.yml:docker-compose.bind.yml
# DATA_DIR=/ingot-data/dockerun
DATABASE_TYPE=sqlite
# MYSQL_DSN=dockerun:password@tcp(mysql.example.com:3306)/dockerun?charset=utf8mb4&parseTime=True&loc=Local
# Direct TLS (put certificates under the persisted data directory):
# TLS_CERT=/var/lib/dockerun/keys/tls.crt
# TLS_KEY=/var/lib/dockerun/keys/tls.key
# Signing/encryption keys are generated and persisted automatically. Back up the entire data directory.
